# Libra Galaxy — configuration template.
# Copy to .env and fill in your own values. Never commit a real .env.

# -- application ---------------------------------------------------------
LIBRA_ENV=local                     # local | test | staging | production
LIBRA_APP_NAME=Libra Galaxy API
LIBRA_API_PREFIX=/api/v1
LIBRA_CORS_ORIGINS=http://localhost:3000

# -- persistence ---------------------------------------------------------
LIBRA_PERSISTENCE_BACKEND=memory    # memory | mongo (deployed must be mongo)
LIBRA_MONGO_URI=mongodb://localhost:27017
LIBRA_MONGO_DATABASE=libra_galaxy

# -- Microsoft Foundry ---------------------------------------------------
# Deployment names are configuration; they must not appear in business logic.
LIBRA_FOUNDRY_ENDPOINT=https://<your-resource>.openai.azure.com
LIBRA_FOUNDRY_API_KEY=<your-key>
LIBRA_FOUNDRY_API_VERSION=2024-10-21
LIBRA_FOUNDRY_CHAT_DEPLOYMENT=gpt-5-mini
LIBRA_FOUNDRY_EMBEDDING_DEPLOYMENT=text-embedding-3-small
LIBRA_FOUNDRY_TIMEOUT_SECONDS=30
# Bump when a deployment change invalidates stored embeddings.
LIBRA_EMBEDDING_VERSION=v1

# -- voice (implementation TBD) ------------------------------------------
LIBRA_VOICE_ENABLED=false
LIBRA_VOICE_REGION=
LIBRA_VOICE_API_KEY=

# -- AI budgets and pricing (USD per million tokens) ---------------------
LIBRA_AI_MAX_OUTPUT_TOKENS=1500
LIBRA_AI_MAX_CONTEXT_CHARS=24000
LIBRA_AI_TOOL_TIMEOUT_SECONDS=15
LIBRA_AI_INPUT_PRICE_PER_MILLION=0.25
LIBRA_AI_CACHED_INPUT_PRICE_PER_MILLION=0.025
LIBRA_AI_OUTPUT_PRICE_PER_MILLION=2.00
LIBRA_AI_EMBEDDING_PRICE_PER_MILLION=0.02

# -- RAG -----------------------------------------------------------------
LIBRA_RAG_CHUNK_SIZE_TOKENS=320
LIBRA_RAG_CHUNK_OVERLAP_TOKENS=60
LIBRA_RAG_EMBEDDING_BATCH_SIZE=16
LIBRA_RAG_TOP_K=5
LIBRA_RAG_MIN_SCORE=0.30
LIBRA_RAG_MAX_RETRIEVED_CHARS=7000

# -- security ------------------------------------------------------------
# Header-based development principals. Refused in staging/production.
LIBRA_DEV_AUTH_ENABLED=true
LIBRA_ACCESS_TOKEN_TTL_SECONDS=900
LIBRA_REFRESH_TOKEN_TTL_SECONDS=1209600

# -- observability -------------------------------------------------------
LIBRA_LOG_LEVEL=INFO
LIBRA_LOG_FORMAT=json               # json | console
LIBRA_REDACT_CONVERSATION_CONTENT=true

# -- frontend ------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
